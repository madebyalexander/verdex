# Verdex — environment template
# Copy to `.env.local` and fill in real values. NEVER commit `.env.local`.
# Vars prefixed NEXT_PUBLIC_ are exposed to the browser bundle — put NOTHING
# secret behind that prefix.

# --- Supabase ---------------------------------------------------------------
# Project URL + anon (publishable) key are safe for the client. The service-role
# key bypasses Row-Level Security — server-only, never expose it.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Upstash Redis (cache + rate limiting) ----------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Market data providers (server-only) ------------------------------------
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FMP_API_KEY=
MARKETAUX_API_KEY=

# --- Google Gemini (AI forecasts, server-only) ------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- SEC EDGAR (insider/fundamental data, server-only) ----------------------
# SEC requires a User-Agent with a real, monitored contact email or it throttles
# requests. Set this to an address you actually own before going live.
SEC_CONTACT_EMAIL=support@verdex.app

# --- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Cron (forecast pre-warming) --------------------------------------------
# High-entropy random string; required to authorize /api/cron/* requests.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# --- Sentry (optional error monitoring) -------------------------------------
# DSN is safe for the client; the auth token is a build-time secret (source maps).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
